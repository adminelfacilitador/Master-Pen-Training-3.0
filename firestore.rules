rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'admin_principal' || getUserRole() == 'admin_vip_tester');
    }
    
    function isStudentEnrolled() {
      return isAuthenticated() && (getUserRole() == 'student_enrolled' || isAdmin());
    }

    // Users collection: user can update own profile, but CANNOT self-assign admin roles (C-04)
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId && (request.resource.data.role == 'student_enrolled' || request.resource.data.role == 'visitor');
      allow update: if isAdmin() || (
        isAuthenticated() && 
        request.auth.uid == userId && 
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
      );
      allow delete: if isAdmin();
    }

    // Courses & Academic Blocks: readable by enrolled students & admins
    match /courses/{courseId} {
      allow read: if isStudentEnrolled();
      allow write: if isAdmin();
      
      match /blocks/{blockId} {
        allow read: if isStudentEnrolled();
        allow write: if isAdmin();
      }
      
      match /question_banks/{blockId} {
        // Question banks are strictly server/admin authoritative to prevent answer leaks
        allow read: if isAdmin();
        allow write: if isAdmin();
      }
    }

    // Exam attempts: students can submit their own attempts
    match /exam_attempts/{attemptId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Certificates: public verification by ID without exposing sensitive documents
    match /certificates/{certificateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Academic state & progress records
    match /academic_state/{stateId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Course slides backup
    match /course_slides/{slideId} {
      allow read: if isStudentEnrolled();
      allow write: if isAdmin();
    }

    // Storage asset catalog
    match /storage_catalog/{assetId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // System Settings & SMTP Credentials (Strict Admin Isolation)
    match /system_settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // Ecosystem Branding & Logos (Public read, Admin update)
    match /ecosystem_branding/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
